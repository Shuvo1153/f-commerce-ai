# Local PostgreSQL. For this long-running backend, use Supabase's session-pooler URL here.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fcommerce
# Direct or session-pooler URL used by Prisma migrations.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/fcommerce
# Optional cloud URL override for the backend container in Docker Compose.
COMPOSE_DATABASE_URL=
JWT_SECRET=replace-with-a-long-random-secret
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional Supabase Storage for product images. Create a public bucket with this name.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

